# CityShield / VisionScan — deployment configuration.
# Copy this file to ".env" (the launcher does this automatically) and adjust.
# Every value is OPTIONAL — the stack runs with the defaults baked into
# docker-compose.yml if you leave .env empty or absent.

# ---- Ports (host side) ----
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- Compute ----
# cpu | cuda  (cuda needs an NVIDIA GPU + nvidia-container-toolkit)
VISIONSCAN_DEVICE=cpu

# ---- Auth (IMPORTANT for production) ----
# Secret used to sign login tokens. start.ps1 generates a random one on first
# run. For Linux/macOS or manual setups, set a long random string here.
VISIONSCAN_JWT_SECRET=cityshield-dev-secret-change-me
# Seed the demo accounts (admin/lead/officer/citizen) on first boot.
# Set to false once you have created real users in production.
VISIONSCAN_SEED_DEMO_USERS=true
# Lock down the VisionScan + Arbiter APIs so they require a login token too.
# Leave false for the open public demo; set true for any real deployment.
VISIONSCAN_REQUIRE_AUTH=false

# ---- Arbiter legal AI (optional) ----
# Without a key, Arbiter runs fully offline (RAG retrieval + cited templates).
# Get a free key at https://aistudio.google.com/apikey
# VISIONSCAN_GEMINI_API_KEY=your_key_here

# ---- Email (optional) ----
# Without SMTP, notification emails queue in an offline outbox table instead.
# VISIONSCAN_SMTP_HOST=smtp.gmail.com
# VISIONSCAN_SMTP_PORT=587
# VISIONSCAN_SMTP_USER=you@gmail.com
# VISIONSCAN_SMTP_PASSWORD=your_app_password
# VISIONSCAN_SMTP_FROM=no-reply@cityshield.local
