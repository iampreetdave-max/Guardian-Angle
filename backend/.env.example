# Copy to .env and adjust for your deployment. All optional — defaults work.

# Device: auto | cpu | cuda
VISIONSCAN_DEVICE=auto

# Where videos, thumbnails, indexes and the DB are stored
# VISIONSCAN_DATA_DIR=../data

# Toggle optional detectors (disable to run lighter on weak field hardware)
VISIONSCAN_ENABLE_DETECTION=true
VISIONSCAN_ENABLE_FACE=true

# YOLO weights (yolov8n.pt = fastest, yolov8s/m/l = more accurate)
VISIONSCAN_YOLO_MODEL_NAME=yolov8n.pt

# Keyframe sampling sensitivity
VISIONSCAN_SCENE_CHANGE_THRESHOLD=0.45
VISIONSCAN_MOTION_THRESHOLD=18.0
VISIONSCAN_MIN_FRAME_INTERVAL_SEC=0.5
VISIONSCAN_MAX_FRAME_INTERVAL_SEC=5.0

# Low-light enhancement
VISIONSCAN_ENABLE_CLAHE=true

# ---- Arbiter legal AI ----
# Optional. Without a key, Arbiter runs fully offline (RAG retrieval + cited
# templates). With a key, it uses Gemini for polished, multilingual generation.
# Get a free key at https://aistudio.google.com/apikey
# VISIONSCAN_GEMINI_API_KEY=your_key_here
# VISIONSCAN_GEMINI_MODEL=gemini-2.0-flash
