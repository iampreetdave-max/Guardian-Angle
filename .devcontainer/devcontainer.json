{
  "name": "CityShield / VisionScan",

  // Plain Ubuntu + Docker-in-Docker: the app already ships its own
  // docker-compose stack, so the codespace only has to be able to run it.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "version": "latest" }
  },

  // 4 cores keeps the first image build (torch + insightface compile) tolerable.
  // Note this burns free quota at 4 core-hours per wall-clock hour: the 120/month
  // included with a personal account is ~30 hours on this size.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },

  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "CityShield app", "onAutoForward": "notify" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },

  // Build and start in the background so the codespace is usable immediately.
  // First run pulls base images and compiles ArcFace — 10-15 minutes.
  "postCreateCommand": "cp -n .env.example .env 2>/dev/null || true; bash deploy/fetch-demo-data.sh; docker compose up -d --build",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
